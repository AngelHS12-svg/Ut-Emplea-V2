# Configuración Base de Datos Local
DB_HOST=db
DB_NAME=cambiar
DB_USER=cambiar
DB_PASSWORD=cambiar
DB_PORT=5432
FLASK_ENV=production

# Generar una clave propia: python -c "import secrets; print(secrets.token_hex(32))"
# No usar una clave de ejemplo ni compartirla. Obligatoria para iniciar.
SECRET_KEY=
PUBLIC_BASE_URL=https://talentlink.duckdns.org
TRUST_PROXY=1
# Por worker; 4 workers x 10 = hasta 40 conexiones.
DB_POOL_MAX=10

MAIL_USERNAME=cambiar
MAIL_PASSWORD=cambiar

# Al usar Render se utilizará automáticamente DATABASE_URL provisto por la plataforma.
# DATABASE_URL=postgresql://user:pass@host/db
